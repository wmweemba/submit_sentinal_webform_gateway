# SMTP Configuration for Nodemailer
# Required for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=Submit Sentinel <your-email@gmail.com>

# Server Configuration (Optional)
PORT=3000
NODE_ENV=production

# Security Settings (Optional)
MAX_FILE_SIZE_MB=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# File Upload Settings
UPLOAD_DIR=./uploads
ALLOWED_MIMETYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Honeypot field name (Optional)
HONEYPOT_FIELD=_honeypot

# Logging (Optional)
LOG_LEVEL=info
